<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HealthID - Secure Medical Profile</title>
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Google Fonts: Poppins (headings) + Hind (body text) — best for Indian readers -->
  <link href="https://fonts.googleapis.com/css2?family=Hind:wght@400;500;600&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>
    /* ============================================================
       HealthID — Indian Light Theme
       Palette: Saffron Orange · Forest Green · Navy · Warm White
    ============================================================ */
    :root {
      --saffron:       #E8672A;
      --saffron-light: #F4895C;
      --saffron-pale:  #FEF3EE;
      --saffron-dark:  #C85520;
      --emerald:       #157A10;
      --emerald-light: #1AAB14;
      --emerald-pale:  #EDFBEA;
      --navy:          #1C2D56;
      --gold:          #E8A219;
      --gold-pale:     #FFFBF0;
      --white:         #FFFFFF;
      --off-white:     #FDFAF6;
      --warm-grey:     #F5EDEA;
      --border-warm:   #EAD9D0;
      --text-dark:     #1A1F2E;
      --text-body:     #3D3840;
      --text-muted:    #7A6E6B;
      --glass-bg:      rgba(255, 250, 244, 0.93);
      --glass-border:  rgba(232, 103, 42, 0.13);
    }

    *, *::before, *::after { box-sizing: border-box; }

    /* ——— BASE ——— */
    body {
      font-family: 'Hind', sans-serif;
      background-color: var(--off-white);
      color: var(--text-body);
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      background-image:
        radial-gradient(ellipse at top left,   rgba(232, 103, 42, 0.08) 0%, transparent 55%),
        radial-gradient(ellipse at top right,  rgba(21, 122, 16, 0.06)  0%, transparent 55%),
        radial-gradient(ellipse at bottom,     rgba(232, 162, 25, 0.04) 0%, transparent 50%);
      background-attachment: fixed;
      animation: fadeInBg 0.6s ease-out;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Poppins', sans-serif;
      color: var(--text-dark);
      letter-spacing: -0.015em;
    }

    /* ——— NAVBAR ——— */
    .navbar-glass {
      background: var(--glass-bg) !important;
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--glass-border);
      box-shadow: 0 2px 20px rgba(232, 103, 42, 0.07);
      padding: 0.85rem 0;
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .navbar-brand {
      font-family: 'Poppins', sans-serif;
      font-weight: 800;
      font-size: 1.55rem;
      letter-spacing: -0.02em;
      background: linear-gradient(135deg, var(--saffron) 20%, var(--gold) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .nav-link {
      font-family: 'Poppins', sans-serif;
      font-weight: 500;
      font-size: 0.9rem;
      color: var(--navy) !important;
      transition: color 0.2s;
      padding: 0.4rem 0.9rem !important;
    }
    .nav-link:hover { color: var(--saffron) !important; }
    .nav-link.text-danger { color: var(--saffron) !important; font-weight: 600; }

    /* ——— CARDS ——— */
    .card-custom {
      background: var(--white);
      border: 1px solid var(--border-warm);
      border-radius: 20px;
      box-shadow: 0 4px 24px rgba(28, 45, 86, 0.06), 0 1px 3px rgba(28, 45, 86, 0.03);
      transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.28s ease;
      animation: fadeInUp 0.5s ease-out forwards;
      opacity: 0;
    }
    .card-custom:hover {
      transform: translateY(-5px);
      box-shadow: 0 16px 40px rgba(232, 103, 42, 0.1), 0 4px 12px rgba(28, 45, 86, 0.06);
    }
    .card-custom.main-card {
      border-top: 4px solid var(--saffron);
    }

    /* ——— PRIMARY BUTTON ——— */
    .btn-primary-custom {
      background: linear-gradient(135deg, var(--saffron), var(--saffron-light));
      color: var(--white);
      border: none;
      padding: 11px 26px;
      border-radius: 50rem;
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.9rem;
      letter-spacing: 0.01em;
      text-decoration: none;
      display: inline-block;
      transition: all 0.25s ease;
      box-shadow: 0 4px 14px rgba(232, 103, 42, 0.4);
      cursor: pointer;
    }
    .btn-primary-custom:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 8px 22px rgba(232, 103, 42, 0.5);
      color: var(--white);
      background: linear-gradient(135deg, var(--saffron-dark), var(--saffron));
    }

    /* ——— OUTLINE BUTTON ——— */
    .btn-outline-custom {
      border: 2px solid var(--saffron);
      color: var(--saffron);
      background: transparent;
      padding: 9px 22px;
      border-radius: 50rem;
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.9rem;
      text-decoration: none;
      display: inline-block;
      transition: all 0.25s;
      cursor: pointer;
    }
    .btn-outline-custom:hover {
      background: var(--saffron);
      color: var(--white);
      box-shadow: 0 4px 14px rgba(232, 103, 42, 0.35);
    }

    /* ——— BOOTSTRAP OVERRIDES ——— */
    .btn-primary, .btn-primary:focus {
      background: linear-gradient(135deg, var(--saffron), var(--saffron-light)) !important;
      border: none !important;
      border-radius: 50rem !important;
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      box-shadow: 0 4px 14px rgba(232, 103, 42, 0.35) !important;
      color: white !important;
    }
    .btn-primary:hover {
      background: linear-gradient(135deg, var(--saffron-dark), var(--saffron)) !important;
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(232, 103, 42, 0.45) !important;
    }
    .btn-outline-primary {
      border: 2px solid var(--saffron) !important;
      color: var(--saffron) !important;
      background: transparent !important;
      border-radius: 50rem !important;
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
    }
    .btn-outline-primary:hover {
      background: var(--saffron) !important;
      color: white !important;
    }
    .btn-outline-danger {
      border: 2px solid #C0392B !important;
      color: #C0392B !important;
      background: transparent !important;
      border-radius: 50rem !important;
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
    }
    .btn-outline-danger:hover {
      background: #C0392B !important;
      color: white !important;
    }
    .btn-outline-success {
      border-radius: 50rem !important;
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
    }
    .btn-outline-dark {
      border-radius: 50rem !important;
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
    }
    .btn-sm { padding: 5px 14px; font-size: 0.78rem; }

    /* ——— INPUTS ——— */
    .form-control, .form-select {
      border-radius: 12px;
      padding: 12px 18px;
      border: 1.5px solid var(--border-warm);
      background-color: var(--off-white);
      color: var(--text-dark);
      font-family: 'Hind', sans-serif;
      font-size: 0.95rem;
      transition: all 0.25s;
    }
    .form-control:focus, .form-select:focus {
      background-color: var(--white);
      border-color: var(--saffron);
      box-shadow: 0 0 0 4px rgba(232, 103, 42, 0.12);
    }
    .form-label {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.86rem;
      color: var(--navy);
      margin-bottom: 6px;
    }
    .input-group .form-control { border-radius: 12px 0 0 12px !important; }
    .input-group .btn { border-radius: 0 50rem 50rem 0 !important; }

    /* ——— TABLES ——— */
    .table {
      font-family: 'Hind', sans-serif;
      font-size: 0.92rem;
    }
    .table thead th {
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      font-size: 0.75rem;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--navy);
      background-color: var(--saffron-pale);
      border-bottom: 2px solid var(--border-warm);
      padding: 13px 16px;
    }
    .table tbody td {
      padding: 12px 16px;
      vertical-align: middle;
      border-color: var(--border-warm);
      color: var(--text-body);
    }
    .table-hover tbody tr { transition: background 0.18s; }
    .table-hover tbody tr:hover { background-color: var(--saffron-pale) !important; }

    /* ——— BADGES ——— */
    .badge {
      padding: 5px 11px;
      border-radius: 7px;
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.72rem;
      letter-spacing: 0.05em;
    }

    /* ——— ALERTS ——— */
    .alert {
      border-radius: 14px;
      border: none;
      font-family: 'Hind', sans-serif;
    }

    /* ——— UTILITY ——— */
    hr { border-color: var(--border-warm); opacity: 1; }
    .text-muted { color: var(--text-muted) !important; }
    .transition-all { transition: all 0.3s ease; }

    /* ——— ANIMATIONS ——— */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeInBg {
      from { opacity: 0; }
      to   { opacity: 1; }
    }

    /* ============================================================
       RESPONSIVE — Tablet (≤ 768px)
    ============================================================ */
    @media (max-width: 768px) {
      /* Container breathing room */
      .container { padding-left: 16px; padding-right: 16px; }

      /* Cards */
      .card-custom { border-radius: 16px; }
      .card-custom.main-card { border-top-width: 3px; }

      /* Typography scale-down */
      h2 { font-size: 1.5rem; }
      h3 { font-size: 1.3rem; }
      h4 { font-size: 1.15rem; }
      h5 { font-size: 1rem; }

      /* Navbar: show hamburger cleanly */
      .navbar-glass { padding: 0.65rem 0; }
      .navbar-brand  { font-size: 1.35rem; }
      .navbar-collapse {
        background: var(--glass-bg);
        border-top: 1px solid var(--glass-border);
        margin-top: 0.5rem;
        padding: 0.75rem 1rem;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 8px 24px rgba(232,103,42,0.06);
      }
      .nav-link { padding: 0.55rem 0.25rem !important; font-size: 0.95rem; }

      /* Dashboard: stack QR card below welcome card */
      .row .col-md-4, .row .col-md-8 { flex: 0 0 100%; max-width: 100%; }

      /* Buttons full-width when stacked */
      .d-flex.flex-wrap.gap-2 .btn { flex: 1 1 calc(50% - 8px); text-align: center; }

      /* Tables: horizontal scroll */
      .table-responsive { border-radius: 12px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
      .table thead th  { font-size: 0.7rem; padding: 10px 12px; white-space: nowrap; }
      .table tbody td  { font-size: 0.85rem; padding: 10px 12px; white-space: nowrap; }

      /* Reports: stack upload + table vertically */
      .row .col-md-4.mb-4, .row .col-md-8 { width: 100%; }

      /* Form: all columns full-width on tablet */
      .col-md-6, .col-md-4, .col-md-2 { flex: 0 0 100%; max-width: 100%; }

      /* Profile view columns */
      .row .col-md-6 { flex: 0 0 100%; max-width: 100%; margin-bottom: 1rem; }

      /* Allergy page result box */
      #resultBox, #recommendationBox { font-size: 0.95rem; }

      /* Modal */
      .modal-dialog { margin: 0.5rem; }
    }

    /* ============================================================
       RESPONSIVE — Phone (≤ 576px)
    ============================================================ */
    @media (max-width: 576px) {
      body { font-size: 0.93rem; }

      /* Tighter page spacing */
      .container.mt-5 { margin-top: 1.25rem !important; }
      .card-custom.p-4 { padding: 1.1rem !important; }

      /* Navbar */
      .navbar-brand { font-size: 1.2rem; }

      /* Headings */
      h2 { font-size: 1.3rem; }
      h4 { font-size: 1.05rem; }

      /* Buttons — stack all vertically on small phones */
      .d-flex.flex-wrap.gap-2 .btn {
        flex: 1 1 100%;
        margin-bottom: 0.4rem;
      }
      .btn-primary-custom, .btn-outline-custom {
        padding: 10px 18px;
        font-size: 0.88rem;
      }

      /* Forms */
      .form-control, .form-select { padding: 11px 14px; font-size: 0.9rem; }
      .input-group .btn { padding: 11px 16px; }

      /* QR card: make image smaller */
      #qr-img { max-width: 130px !important; }

      /* Action buttons in table: stack with spacing */
      td .btn-sm { margin-bottom: 4px; }

      /* Allergy input full-width group */
      .input-group { flex-direction: column; }
      .input-group .form-control { border-radius: 12px !important; width: 100% !important; }
      .input-group .btn          { border-radius: 50rem !important; margin-top: 8px; width: 100%; }

      /* Emergency contacts: single column */
      .contact-block .row.g-2 > div { flex: 0 0 100%; max-width: 100%; }

      /* Profile view badge */
      .badge.fs-6 { font-size: 0.95rem !important; }
    }
  </style>
</head>
<body>
