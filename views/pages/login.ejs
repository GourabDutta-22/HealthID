<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <%- include('../partials/messages') %>
      
      <div class="card card-custom p-4">
        <h3 class="text-center mb-4 fw-bold">
          <% if (typeof savedEmail !== 'undefined' && savedEmail) { %>
            Welcome Back!
          <% } else { %>
            Welcome Back
          <% } %>
        </h3>

        <% if (typeof savedEmail !== 'undefined' && savedEmail) { %>
          <!-- PIN Login Form for Returning Users -->
          <form action="/auth/login-pin" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="email" value="<%= savedEmail %>">
            
            <div class="text-center mb-4">
              <p class="text-muted fw-bold mb-1"><%= savedEmail %></p>
              <p class="small text-muted">Enter your 4-digit PIN</p>
            </div>
            
            <div class="mb-4 text-center">
              <input type="password" class="form-control form-control-lg text-center mx-auto fw-bold fs-3" 
                     id="pin" name="pin" maxlength="4" pattern="\d{4}" placeholder="••••" 
                     style="width: 150px; letter-spacing: 0.5em;" required autocomplete="off" autofocus>
            </div>
            <button type="submit" class="btn btn-primary-custom w-100 mb-3">Log In with PIN</button>
          </form>
          
          <div class="text-center mt-3">
            <a href="#" onclick="document.cookie='saved_email=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;'; window.location.reload();" class="text-muted text-decoration-none small">
              Not you? Log in with password
            </a>
          </div>
        <% } else { %>
          <!-- Standard Email/Password Login Form -->
          <form action="/auth/login" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label for="email" class="form-label">Email Address</label>
              <input type="email" class="form-control" id="email" name="email" placeholder="Enter Email" required autofocus>
            </div>
            <div class="mb-4">
              <label for="password" class="form-label">Password</label>
              <input type="password" class="form-control" id="password" name="password" placeholder="Enter Password" required>
            </div>
            <button type="submit" class="btn btn-primary-custom w-100">Log In</button>
          </form>
          <p class="mt-4 text-center text-muted">
            Don't have an account? <a href="/auth/register" class="text-decoration-none">Register</a>
          </p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
