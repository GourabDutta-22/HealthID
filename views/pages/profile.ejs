<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <%- include('../partials/messages') %>
      
      <div class="card card-custom p-4">
        <h3 class="fw-bold mb-4">Complete Medical Profile</h3>
        <form action="/profile/edit" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          
          <div class="text-center mb-4">
            <% if (user.profilePicture) { %>
              <img id="profilePreview" src="<%= user.profilePicture %>" alt="Profile Photo" class="rounded-circle mb-3 border border-3 border-light shadow-sm" style="width: 120px; height: 120px; object-fit: cover;">
            <% } else { %>
              <div id="profilePlaceholder" class="rounded-circle bg-light d-inline-flex justify-content-center align-items-center mb-3 shadow-sm" style="width: 120px; height: 120px;">
                <i class="bi bi-person text-secondary" style="font-size: 4rem;"></i>
              </div>
              <img id="profilePreview" src="" alt="Profile Photo" class="rounded-circle mb-3 border border-3 border-light shadow-sm d-none" style="width: 120px; height: 120px; object-fit: cover;">
            <% } %>
            <div>
              <label class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-camera"></i> Change Photo
                <input type="file" name="profilePhoto" id="profilePhotoInput" accept="image/*" class="d-none">
              </label>
            </div>
          </div>

          <h5 class="text-primary border-bottom pb-2 mb-3">Basic Information</h5>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Full Name</label>
              <input type="text" class="form-control" name="fullName" value="<%= record ? record.fullName : user.firstName + ' ' + (user.lastName || '') %>" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Date of Birth</label>
              <input type="date" class="form-control" name="dateOfBirth" value="<%= record && record.dateOfBirth ? record.dateOfBirth.toISOString().split('T')[0] : '' %>" required>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Gender</label>
              <select class="form-select" name="gender" required>
                <option value="Male" <%= record && record.gender === 'Male' ? 'selected' : '' %>>Male</option>
                <option value="Female" <%= record && record.gender === 'Female' ? 'selected' : '' %>>Female</option>
                <option value="Other" <%= record && record.gender === 'Other' ? 'selected' : '' %>>Other</option>
                <option value="Prefer not to say" <%= record && record.gender === 'Prefer not to say' ? 'selected' : '' %>>Prefer not to say</option>
              </select>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Blood Group</label>
              <input type="text" class="form-control" name="bloodGroup" value="<%= record ? record.bloodGroup : '' %>" placeholder="e.g. O+" required>
            </div>
            <div class="col-md-2 mb-3">
              <label class="form-label">Height (cm)</label>
              <input type="number" class="form-control" name="height" value="<%= record ? record.height : '' %>" required>
            </div>
            <div class="col-md-2 mb-3">
              <label class="form-label">Weight (kg)</label>
              <input type="number" class="form-control" name="weight" value="<%= record ? record.weight : '' %>" required>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Your Contact Number</label>
              <input type="tel" class="form-control" name="phone" value="<%= record && record.phone ? record.phone : '' %>" placeholder="e.g. +91 98765 43210">
            </div>
          </div>

          <h5 class="text-primary border-bottom pb-2 mb-3 mt-4">Medical Details</h5>
          <div class="mb-3">
            <label class="form-label">Allergies (comma separated)</label>
            <input type="text" class="form-control" name="allergies" value="<%= record ? record.allergies.join(', ') : '' %>" placeholder="e.g. Peanuts, Penicillin">
          </div>
          <div class="mb-3">
            <label class="form-label">Current Medications (comma separated)</label>
            <input type="text" class="form-control" name="currentMedications" value="<%= record ? record.currentMedications.join(', ') : '' %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Existing Diseases / Conditions (comma separated)</label>
            <input type="text" class="form-control" name="existingDiseases" value="<%= record ? record.existingDiseases.join(', ') : '' %>" placeholder="e.g. Diabetes, Asthma">
          </div>

          <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
            <h5 class="mb-0" style="color:var(--navy);font-family:'Poppins',sans-serif;">Emergency Contacts</h5>
            <button type="button" id="addContactBtn" class="btn btn-outline-custom btn-sm">
              <i class="bi bi-plus-circle me-1"></i> Add Contact
            </button>
          </div>
          <p class="text-muted small mb-3">You can add up to 3 emergency contacts (minimum 0).</p>

          <div id="contactsContainer">
            <% const contacts = (record && record.emergencyContacts) ? record.emergencyContacts : []; %>
            <% contacts.forEach(function(contact, i) { %>
              <div class="contact-block border rounded-3 p-3 mb-3" style="background:var(--saffron-pale);border-color:var(--border-warm)!important;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="fw-bold" style="font-family:'Poppins',sans-serif;font-size:0.87rem;color:var(--navy);">Contact <%= i + 1 %></span>
                  <button type="button" class="remove-contact-btn btn btn-sm btn-outline-danger">Remove</button>
                </div>
                <div class="row g-2">
                  <div class="col-md-4">
                    <label class="form-label">Full Name</label>
                    <input type="text" class="form-control" name="contactName[]" value="<%= contact.name %>" placeholder="Contact's name" required>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Relationship</label>
                    <input type="text" class="form-control" name="contactRelation[]" value="<%= contact.relationship %>" placeholder="e.g. Father, Wife" required>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Phone Number</label>
                    <input type="tel" class="form-control" name="contactPhone[]" value="<%= contact.phoneNumber %>" placeholder="+91 98765 43210" required>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>

          <button type="submit" class="btn btn-primary-custom w-100 mt-4">Save Medical Profile</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const container = document.getElementById('contactsContainer');
    const addBtn   = document.getElementById('addContactBtn');

    function buildBlock(idx) {
      const block = document.createElement('div');
      block.className = 'contact-block border rounded-3 p-3 mb-3';
      block.style.cssText = 'background:var(--saffron-pale);border-color:var(--border-warm)!important;';
      block.innerHTML =
        '<div class="d-flex justify-content-between align-items-center mb-2">' +
          '<span class="fw-bold" style="font-family:Poppins,sans-serif;font-size:0.87rem;color:var(--navy);">Contact ' + idx + '</span>' +
          '<button type="button" class="remove-contact-btn btn btn-sm btn-outline-danger">Remove</button>' +
        '</div>' +
        '<div class="row g-2">' +
          '<div class="col-md-4">' +
            '<label class="form-label">Full Name</label>' +
            '<input type="text" class="form-control" name="contactName[]" placeholder="Contact\'s name" required>' +
          '</div>' +
          '<div class="col-md-4">' +
            '<label class="form-label">Relationship</label>' +
            '<input type="text" class="form-control" name="contactRelation[]" placeholder="e.g. Father, Wife" required>' +
          '</div>' +
          '<div class="col-md-4">' +
            '<label class="form-label">Phone Number</label>' +
            '<input type="tel" class="form-control" name="contactPhone[]" placeholder="+91 98765 43210" required>' +
          '</div>' +
        '</div>';
      return block;
    }

    function renumber() {
      container.querySelectorAll('.contact-block').forEach(function (block, i) {
        block.querySelector('span').textContent = 'Contact ' + (i + 1);
      });
    }

    function syncButton() {
      const count = container.querySelectorAll('.contact-block').length;
      if (count >= 3) {
        addBtn.disabled = true;
        addBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Max 3 Reached';
      } else {
        addBtn.disabled = false;
        addBtn.innerHTML = '<i class="bi bi-plus-circle me-1"></i> Add Contact';
      }
    }

    // Add contact
    addBtn.addEventListener('click', function () {
      const count = container.querySelectorAll('.contact-block').length;
      if (count >= 3) return;
      container.appendChild(buildBlock(count + 1));
      syncButton();
    });

    // Remove contact — event delegation so it works for existing AND new blocks
    container.addEventListener('click', function (e) {
      if (e.target.classList.contains('remove-contact-btn')) {
        e.target.closest('.contact-block').remove();
        renumber();
        syncButton();
      }
    });

    // Init button state on load
    syncButton();
  });
</script>

<script>
  document.getElementById('profilePhotoInput').addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = function(e) {
        const preview = document.getElementById('profilePreview');
        const placeholder = document.getElementById('profilePlaceholder');
        
        preview.src = e.target.result;
        preview.classList.remove('d-none');
        if (placeholder) {
          placeholder.classList.add('d-none');
        }
      }
      reader.readAsDataURL(file);
    }
  });
</script>

<%- include('../partials/footer') %>
