<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Emergency Medical Profile</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #dc3545; color: #fff; }
    .emergency-card { background: #fff; color: #333; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
    .alert-banner { background-color: #ffc107; color: #000; font-weight: bold; text-align: center; padding: 10px; border-radius: 12px 12px 0 0; }
  </style>
</head>
<body>
  <div class="container mt-5 mb-5">
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="text-center mb-4">
          <h1 class="fw-bold">🚨 EMERGENCY MEDICAL INFO</h1>
          <p>Please provide this information to first responders immediately.</p>
        </div>
        
        <div class="emergency-card">
          <div class="alert-banner">
            CONFIDENTIAL MEDICAL DATA
          </div>
          <div class="p-4">
            <% if (profilePicture) { %>
              <div class="text-center mb-3 mt-2">
                <img src="<%= profilePicture %>" alt="Patient Photo" class="rounded-circle border border-3 border-danger shadow" style="width: 100px; height: 100px; object-fit: cover;">
              </div>
            <% } %>
            <h3 class="fw-bold border-bottom pb-2 mb-3 text-center"><%= record.fullName %></h3>
            
            <div class="row mb-4">
              <div class="col-6">
                <p class="text-muted mb-0">Blood Group</p>
                <h2 class="text-danger fw-bold"><%= record.bloodGroup %></h2>
              </div>
              <div class="col-6">
                <p class="text-muted mb-0">DOB</p>
                <p class="fw-bold fs-5"><%= record.dateOfBirth.toDateString() %></p>
              </div>
            </div>

            <div class="mb-4">
              <h5 class="text-muted border-bottom pb-2">Critical Alerts</h5>
              <p><strong>Allergies:</strong> <span class="text-danger fw-bold"><%= record.allergies.length > 0 ? record.allergies.join(', ') : 'None' %></span></p>
              <p><strong>Current Meds:</strong> <%= record.currentMedications.length > 0 ? record.currentMedications.join(', ') : 'None' %></p>
              <p><strong>Conditions:</strong> <%= record.existingDiseases.length > 0 ? record.existingDiseases.join(', ') : 'None' %></p>
            </div>

            <div>
              <h5 class="text-muted border-bottom pb-2">Emergency Contacts</h5>
              <% if(record.emergencyContacts.length > 0) { %>
                <% record.emergencyContacts.forEach(function(contact) { %>
                  <div class="mb-2 p-3 bg-light rounded border">
                    <p class="mb-1 fw-bold"><%= contact.name %> (<%= contact.relationship %>)</p>
                    <a href="tel:<%= contact.phoneNumber %>" class="btn btn-danger btn-sm w-100">CALL <%= contact.phoneNumber %></a>
                  </div>
                <% }); %>
              <% } else { %>
                <p>No emergency contacts listed.</p>
              <% } %>
            </div>
            
            <div>
              <h5 class="text-muted border-bottom pb-2 mt-4">Medical Reports</h5>
              <% if(record.reports && record.reports.length > 0) { %>
                <div class="list-group mb-4">
                  <% record.reports.forEach(function(report) { %>
                    <a href="<%= report.fileUrl %>" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                      <div>
                        <strong><%= report.title %></strong><br>
                        <small class="text-muted"><%= report.uploadedAt.toDateString() %></small>
                      </div>
                      <span class="badge bg-primary rounded-pill"><%= report.fileType.toUpperCase() %></span>
                    </a>
                  <% }); %>
                </div>
              <% } else { %>
                <p>No medical reports uploaded.</p>
              <% } %>
            </div>

            <div class="mt-4 p-4 bg-light rounded border border-danger">
              <h5 class="fw-bold text-danger mb-3"><i class="bi bi-shield-check"></i> Emergency Allergy Check</h5>
              <p class="small text-muted mb-3">Enter a medication to instantly check if it is safe against <%= record.fullName %>'s active allergies.</p>
              
              <form id="emergencyAllergyForm">
                <input type="hidden" id="qrCodeId" value="<%= qrCodeId %>">
                <input type="hidden" id="csrfToken" value="<%= csrfToken %>">
                <div class="mb-3">
                  <input type="text" id="medicineInput" class="form-control mb-3" placeholder="e.g. Amoxicillin, Ibuprofen" required>
                  <button class="btn btn-danger w-100" type="submit">Check Safety</button>
                </div>
              </form>

              <div id="resultBox" class="mt-3 p-3 rounded d-none border">
                <h6 id="resultStatus" class="fw-bold mb-1"></h6>
                <p id="resultMessage" class="mb-0 small"></p>
              </div>
              
              <div id="recommendationBox" class="mt-2 p-3 rounded d-none border border-success bg-success bg-opacity-10 text-success-emphasis">
                <h6 class="fw-bold mb-1">Safe Alternatives</h6>
                <p id="recommendationMessage" class="mb-0 small lh-base"></p>
              </div>
            </div>
            
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('emergencyAllergyForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const medicineName = document.getElementById('medicineInput').value;
      const qrCodeId = document.getElementById('qrCodeId').value;
      const csrfToken = document.getElementById('csrfToken').value;
      
      const resultBox = document.getElementById('resultBox');
      const resultStatus = document.getElementById('resultStatus');
      const resultMessage = document.getElementById('resultMessage');
      const recommendationBox = document.getElementById('recommendationBox');
      const recommendationMessage = document.getElementById('recommendationMessage');
      
      resultBox.className = 'mt-3 p-3 rounded border'; 
      resultStatus.innerText = 'Analyzing...';
      resultMessage.innerText = 'Cross-referencing database...';
      resultBox.classList.remove('d-none');
      recommendationBox.classList.add('d-none');
      recommendationMessage.innerText = '';

      try {
        const response = await fetch('/allergy/check-emergency/' + qrCodeId, {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'x-csrf-token': csrfToken
          },
          body: JSON.stringify({ medicineName })
        });
        
        const data = await response.json();
        
        resultStatus.innerText = data.status;
        resultMessage.innerText = data.message;
        
        if (data.status === 'High Risk') {
          resultBox.classList.add('bg-danger', 'text-white', 'border-danger');
        } else if (data.status === 'Warning') {
          resultBox.classList.add('bg-warning', 'text-dark', 'border-warning');
        } else if (data.status === 'Safe') {
          resultBox.classList.add('bg-success', 'text-white', 'border-success');
        } else {
          resultBox.classList.add('bg-secondary', 'text-white');
        }
        
        if (data.recommendations) {
          recommendationMessage.innerText = data.recommendations;
          recommendationBox.classList.remove('d-none');
        }
        
      } catch (err) {
        resultStatus.innerText = 'System Error';
        resultMessage.innerText = 'Failed to connect to the medical database.';
        resultBox.classList.add('bg-danger', 'text-white');
      }
    });
  </script>
    </div>
  </div>
</body>
</html>
